{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend API for product canonicalization and matching",
  "packageManager": "pnpm@10.15.1",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "tsx src/server.ts",
    "worker": "tsx src/jobs/worker.ts",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "migrate": "node -r tsx/cjs src/migrate.ts",
    "migrate:concurrent": "node -r tsx/cjs src/migrate-concurrent.ts"
  },
  "dependencies": {
    "@fastify/cors": "^8.4.0",
    "@fastify/rate-limit": "^9.0.1",
    "@find/extraction": "workspace:*",
    "@find/sdk": "workspace:*",
    "@find/types": "workspace:*",
    "@google/genai": "^1.30.0",
    "@langchain/community": "^1.0.4",
    "@langchain/core": "^1.0.6",
    "@langchain/google-genai": "^1.0.3",
    "@langchain/openai": "^1.1.2",
    "@types/form-data": "^2.5.2",
    "@types/sharp": "^0.32.0",
    "@xenova/transformers": "^2.17.2",
    "bullmq": "^5.58.5",
    "cheerio": "^1.1.2",
    "dotenv": "^16.3.1",
    "fastify": "^4.24.3",
    "form-data": "^4.0.4",
    "ioredis": "^5.7.0",
    "langchain": "^1.0.6",
    "langsmith": "^0.2.15",
    "nanoid": "^5.0.4",
    "node-fetch": "^3.3.2",
    "openai": "^6.10.0",
    "pg": "^8.11.3",
    "pino": "^8.16.2",
    "sharp": "^0.34.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/node": "^20.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.10.9",
    "tsx": "^4.6.2",
    "typescript": "^5.3.2",
    "vitest": "^1.0.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
