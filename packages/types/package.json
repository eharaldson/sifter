{
  "name": "@find/types",
  "version": "1.0.0",
  "description": "Shared TypeScript types for the Find AI Shopping Assistant",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "typescript": "^5.3.2"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
